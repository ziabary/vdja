{
    "name": "targoman_llm",
    "version": "1.0.0",
    "description": "Base Targoman LLM Project",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "sdev": "nodemon --watch src --watch .env --ext ts,json --exec tsx src/index.ts",
        "build": "tsc",
        "lint": "eslint 'src/**/*.{ts,tsx}'",
        "fix": "eslint 'src/**/*.{ts,tsx}' --fix",
        "lint:watch": "chokidar 'src/**/*.{ts,tsx}' -c 'eslint src/**/*.{ts,tsx}'",
        "dev": "concurrently npm:lint:watch npm:sdev",
        "prod": "npm run build && node dist/index.js",
        "obfuscate": "javascript-obfuscator dist/index.js --output dist/index.obfuscated.js"
    },
    "keywords": [
        "LLM",
        "Targoman",
        "RAG"
    ],
    "author": "S.Mehran M.Ziabary",
    "license": "ISC",
    "devDependencies": {
        "@types/cookie": "^0.6.0",
        "@types/knex": "^0.15.2",
        "@types/node": "^25.0.10",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "javascript-obfuscator": "^5.1.0",
        "nodemon": "^3.1.11",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@qdrant/js-client-rest": "^1.16.2",
        "arabic-persian-reshaper": "^1.0.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.19.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.1.0",
        "md5": "^2.3.0",
        "morgan": "^1.10.1",
        "ms": "^2.1.3",
        "mssql": "^12.2.0",
        "multer": "^2.0.2",
        "mysql2": "^3.16.1",
        "openid-client": "^6.8.1",
        "pdfjs-dist": "^4.0.379",
        "pg": "^8.17.2",
        "unorm": "^1.6.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "winston-format": "^1.0.1"
    }
}
