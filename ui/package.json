{
    "name": "targoman_llm",
    "version": "1.0.0",
    "description": "Base Targoman LLM Project",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "sdev": "nodemon --watch src --watch .env --ext ts,json --exec tsx src/index.ts",
        "build": "tsc",
        "lint": "eslint 'src/**/*.{ts,tsx}'",
        "fix": "eslint 'src/**/*.{ts,tsx}' --fix",
        "lint:watch": "chokidar 'src/**/*.{ts,tsx}' -c 'eslint src/**/*.{ts,tsx}'",
        "dev": "concurrently npm:lint:watch npm:sdev",
        "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --minify --external:@qdrant/js-client-rest --external:arabic-persian-reshaper --external:cookie-parser --external:cors --external:dotenv --external:express --external:express-rate-limit --external:express-session --external:jsonwebtoken --external:knex --external:md5 --external:morgan --external:ms --external:mssql --external:multer --external:mysql2 --external:openid-client --external:pdfjs-dist --external:pg --external:unorm --external:winston --external:winston-daily-rotate-file --external:winston-format",
        "obfuscate": "javascript-obfuscator dist/index.js --output dist/index.js --config-file obfuscator.config.json",
        "prod": "npm run build && npm run bundle && npm run obfuscate && node dist/index.js",
        "build:frontend": "npm run minify:html && npm run minify:css && npm run obfuscate:js",
        "minify:html": "npx html-minifier-next --input-dir public --output-dir public-dist --file-ext html --collapse-whitespace --remove-comments --remove-optional-tags --remove-redundant-attributes --remove-script-type-attributes --remove-tag-whitespace --minify-css true --minify-js true",
        "minify:css": "cleancss --batch --batch-suffix .min public/**/*.css -o public-dist",
        "obfuscate:js": "node scripts/obfuscate-frontend.js"
    },
    "keywords": [
        "LLM",
        "Targoman",
        "RAG"
    ],
    "author": "S.Mehran M.Ziabary",
    "license": "ISC",
    "devDependencies": {
        "@types/cookie": "^0.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/knex": "^0.15.2",
        "@types/md5": "^2.3.6",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.0.10",
        "@types/uuid": "^11.0.0",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "chokidar-cli": "^3.0.0",
        "clean-css-cli": "^5.6.3",
        "concurrently": "^9.2.1",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.2",
        "glob": "^13.0.6",
        "html-minifier-next": "^5.1.2",
        "javascript-obfuscator": "^5.3.0",
        "nodemon": "^3.1.11",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@qdrant/js-client-rest": "^1.16.2",
        "arabic-persian-reshaper": "^1.0.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.19.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.1.0",
        "md5": "^2.3.0",
        "morgan": "^1.10.1",
        "ms": "^2.1.3",
        "mssql": "^12.2.0",
        "multer": "^2.0.2",
        "mysql2": "^3.16.1",
        "openid-client": "^6.8.1",
        "pdfjs-dist": "^4.0.379",
        "pg": "^8.17.2",
        "unorm": "^1.6.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "winston-format": "^1.0.1"
    }
}
