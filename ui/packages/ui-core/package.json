{
  "name": "@targoman/ui-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown-render": {
      "browser": "./src/rich-content/render.browser.ts",
      "node": "./src/rich-content/render.server.ts",
      "default": "./src/rich-content/render.server.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@targoman/contracts": "1.0.0",
    "@tanstack/table-core": "8.21.3",
    "dompurify": "3.4.16",
    "jsdom": "26.1.0",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/jsdom": "30.0.0",
    "svelte-check": "4.7.6",
    "svelte": "5.57.1",
    "typescript": "6.0.3"
  }
}
